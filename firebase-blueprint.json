{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce catalog product entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "sku": { "type": "string", "maxLength": 100 },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "discountPrice": { "type": "number" },
        "totalStock": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Draft", "Inactive", "Archived"] },
        "mainImage": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "sku", "sellingPrice", "totalStock", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category hierarchy item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["name", "slug", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["Unpaid", "Paid", "Refunded"] },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerId", "total", "orderStatus"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountValue": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["code", "discountValue", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog products collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User accounts collection"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional coupons collection"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "System security audit logs collection"
    }
  }
}
